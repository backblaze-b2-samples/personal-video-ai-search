# Backblaze B2 (required)
B2_ENDPOINT=your_b2_endpoint
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=us-west-004

# Example of what filled-in values look like (fake — for visual reference only):
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_APPLICATION_KEY_ID=000000000example00000000a
# B2_APPLICATION_KEY=EXAMPLEonlyFAKEapplicationKEYvalue
# B2_BUCKET_NAME=my-video-archive-bucket
# B2_REGION=us-west-004

# --- Web app ---
# Where the browser reaches the API. Optional for local dev (defaults to
# http://localhost:8000); set it when the web app and API run on different
# hosts (e.g. on Railway — see infra/railway/README.md).
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Search date/event filters are gated for rolling deploy safety. Leave disabled
# until every API instance has the closed SearchRequest schema and filter logic.
NEXT_PUBLIC_SEARCH_FILTERS_ENABLED=false

# --- AI providers (multimodal index pipeline) ---
# Leave both blank to run with the generic B2 features only (upload, files,
# dashboard). Ingest / visual indexing / search / people will surface a clear
# "configure a provider" state instead of crashing.
#
# OPENAI_API_KEY    — the one required key: Whisper transcription
#                     (whisper-1) + gpt-4o-mini vision captions/tags +
#                     text-embedding-3-small embeddings.
# ANTHROPIC_API_KEY — optional; claude-haiku-4-5 synthesizes a short answer
#                     over the top matching clips.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Faces are detected, embedded, and clustered LOCALLY (no API key, $0 cost).
# The first ingest with face indexing downloads the model weights once.

# --- Optional knobs (defaults live in services/api/app/config/settings.py) ---
# VISION_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# ANSWER_MODEL=claude-haiku-4-5
# VIDEO_PREFIX=personal-video-ai-search/
# MAX_VIDEO_SIZE=5368709120              # 5 GiB
# MAX_KEYFRAMES_PER_VIDEO=8
# SCENE_THRESHOLD=0.30
